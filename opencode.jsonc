{
    "$schema": "https://opencode.ai/config.json",
    "permissions": [
        { "action": "shell", "resource": "git commit *", "effect": "ask" },
        { "action": "shell", "resource": "git push *", "effect": "deny" }
    ],
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    }
}
